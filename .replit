modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "campaign-regressions"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "campaign-browser-regressions"

[[workflows.workflow]]
name = "campaign-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python -m unittest discover -s artifacts/campaign-analyzer -p 'test_*.py' -v"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "campaign-browser-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/campaign-analyzer run typecheck:browser && pnpm --filter @workspace/campaign-analyzer run test:browser"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]
